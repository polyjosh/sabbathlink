# Supabase project (Settings > API Keys). Leave empty to run the UI on seed data.
# Use the publishable key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site URL, used in share links
NEXT_PUBLIC_SITE_URL=https://sabbathlink.co.ke

# SMS through Africa's Talking (server only; never NEXT_PUBLIC). Leave empty to
# keep SMS waiting in the queue. Username "sandbox" uses the test sandbox.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional registered sender ID; Africa's Talking's default is used when empty.
AFRICASTALKING_SENDER_ID=
# Secret from Supabase > Authentication > Hooks > Send SMS (v1,whsec_...).
# The hook URL is https://<your site>/api/auth/send-sms
SEND_SMS_HOOK_SECRET=
